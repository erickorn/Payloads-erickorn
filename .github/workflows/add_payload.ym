name: Agregar Nuevo Payload por URL

on:
  workflow_dispatch:
    inputs:
      payload_url:
        description: 'URL o repositorio de GitHub (ej: https://github.com/usuario/repo)'
        required: true
        type: string
      category:
        description: 'Categoría'
        required: false
        default: 'Utilities'
        type: choice
        options:
          - Utilities
          - System and Mounts
          - Kernel Tools
          - Tiendas
          - Development

permissions:
  contents: write

jobs:
  add-and-update:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 0

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Agregar nueva fuente a sources.json
        run: python add_source.py "${{ inputs.payload_url }}" "${{ inputs.category }}"

      - name: Actualizar payloads.json
        run: python update_payloads.py

      - name: Guardar y subir cambios
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add -u
          if ! git diff --staged --quiet; then
            git commit -m "Add: Nuevo payload agregado via URL workflow"
            git push origin HEAD:${{ github.ref }}
          fi
